# ──────────────────────────────────────────────────────────────────────────────
# REQUIRED — set this in Vercel dashboard under Project → Settings → Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# The publicly reachable URL of your Railway backend (no trailing slash).
# This is a BUILD-TIME variable — after changing it you must redeploy the frontend.
NEXT_PUBLIC_API_URL=https://your-backend.railway.app
